# ─────────────────────────────────────────────────────────────────────
# Wismify Partner Wrapper — credenciales
# ─────────────────────────────────────────────────────────────────────

# Webhook secret que Wismify te dio al finalizar la app (empieza por whsec_).
# Lo usamos para verificar la firma HMAC-SHA256 en cada llamada entrante.
WISMIFY_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Tu API key del backend al que vas a llamar (ejemplo Obsydian).
# Aquí pon lo que necesites de TU API; nada de esto lo ve Wismify.
OBSYDIAN_API_KEY_ID=apk_xxxxxxxxxxxxxxxxx
OBSYDIAN_API_KEY_SECRET=opr_live_xxxxxxxxxxxxxxxxx

# Puerto donde escucha el wrapper. Detrás del proxy / Cloudflare.
PORT=3000
