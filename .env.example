# ─────────────────────────────────────────────────────────────────────
# Wismify Partner Wrapper — variables de entorno a configurar
# ─────────────────────────────────────────────────────────────────────
# Crea tu propio archivo .env (NO lo publiques) con estas variables:
#
#   WISMIFY_WEBHOOK_SECRET   El secreto que Wismify te dio al finalizar la app
#                            (empieza por whsec_). Verifica la firma HMAC-SHA256
#                            de cada llamada entrante.
#   OBSYDIAN_API_KEY_ID      API key del backend al que vas a llamar (ejemplo
#   OBSYDIAN_API_KEY_SECRET  Obsydian). Es TU API; nada de esto lo ve Wismify.

# Puerto donde escucha el wrapper. Detrás del proxy / Cloudflare.
PORT=3000
